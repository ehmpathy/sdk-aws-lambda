exports[`getOneHandlerFromServerlessYml given: [case1] a project root with no serverless.yml at all when: [t0] the lookup runs then: the error names the sought path AND the way out 1`] = `
{
  "messageNamesAbsence": true,
  "namesCloudFix": true,
  "namesServerlessYml": true,
}
`;

exports[`getOneHandlerFromServerlessYml given: [case2] a serverless.yml whose handler string is malformed when: [t0] the lookup runs then: the error shows what it found, so the typo is visible 1`] = `
