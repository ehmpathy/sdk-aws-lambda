exports[`genLambdaEndpoint.forSns given: [case5] an invoke of other than one message when: [t0] two messages arrive then: it fails loud, and names the fix 1`] = `
"💥 MalfunctionError: forSns received a batch of other than one message

{
  "count": 2,
  "fix": "sns delivers one message per invoke; check that this lambda is subscribed to an sns topic, and not invoked by another source",
  "ids": [
    "<uuid>",
    "<uuid>"
  ]
}"
`;

