  "batchItemFailures": [
    {
      "itemIdentifier": "msg-1",
    },
  ],
}
`;

exports[`the sqs queue input given: [case3] a consumer reaches perBatch through the family object when: [t0] a batch of three arrives, one poison and one unparseable then: the refused message never reached the handler 1`] = `
