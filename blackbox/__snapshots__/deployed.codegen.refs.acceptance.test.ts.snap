} from 'domain-objects';

export interface SvcTrophySeaturtle {
  uuid: string;
  name: string;
}

export class SvcTrophySeaturtle
  extends DomainEntity<SvcTrophySeaturtle>
  implements SvcTrophySeaturtle
{
  public static primary = ['uuid'] as const;
  public static alias = { singular: 'seaturtle', plural: 'seaturtles' };
}

export interface SvcTrophySponsor {
  uuid: string;
  handle: string;
}

export class SvcTrophySponsor
  extends DomainEntity<SvcTrophySponsor>
  implements SvcTrophySponsor
{
  public static primary = ['uuid'] as const;
  public static unique = ['handle'] as const;
  public static alias = { singular: 'sponsor', plural: 'sponsors' };
}

export interface SvcTrophySurfboard {
  brand: string;
  lengthInInches: number;
}

export class SvcTrophySurfboard
  extends DomainLiteral<SvcTrophySurfboard>
  implements SvcTrophySurfboard
{
  public static unique = ['brand', 'lengthInInches'] as const;
  public static alias = { singular: 'surfboard', plural: 'surfboards' };
}

export interface SvcTrophySurfTrophy {
  uuid: string;
  rider: RefByPrimary<typeof SvcTrophySeaturtle>;
  board: RefByUnique<typeof SvcTrophySurfboard>;
  sponsor: Ref<typeof SvcTrophySponsor>;
}

export class SvcTrophySurfTrophy
  extends DomainEntity<SvcTrophySurfTrophy>
  implements SvcTrophySurfTrophy
{
  public static primary = ['uuid'] as const;
  public static alias = { singular: 'trophy', plural: 'trophies' };
}
