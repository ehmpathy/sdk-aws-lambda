    askLambdaEndpoint<{ uuid: string }, { rider: SvcTrophySeaturtle }>(
      { which: { service: 'svc-trophy', function: 'getRider' }, event },
      context,
    ),
  getSponsor: (
    event: { uuid: string },
    context: ContextAwsLambdaCaller,
  ): Promise<{ sponsor: SvcTrophySponsor }> =>
    askLambdaEndpoint<{ uuid: string }, { sponsor: SvcTrophySponsor }>(
      { which: { service: 'svc-trophy', function: 'getSponsor' }, event },
      context,
    ),
  getTrophy: (
    event: { uuid: string },
    context: ContextAwsLambdaCaller,
  ): Promise<{ trophy: SvcTrophySurfTrophy }> =>
