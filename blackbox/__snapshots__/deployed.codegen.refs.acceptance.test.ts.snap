import { askLambdaEndpoint, type ContextAwsLambdaCaller } from 'sdk-aws-lambda';
import type {
  SvcTrophySeaturtle,
  SvcTrophySponsor,
  SvcTrophySurfboard,
  SvcTrophySurfTrophy,
} from './svcTrophy.resources';

export const svcTrophy = {
  getBoard: (
    event: { brand: string },
    context: ContextAwsLambdaCaller,
  ): Promise<{ board: SvcTrophySurfboard }> =>
    askLambdaEndpoint<{ brand: string }, { board: SvcTrophySurfboard }>(
      { which: { service: 'svc-trophy', function: 'getBoard' }, event },
      context,
    ),
  getRider: (
    event: { uuid: string },
    context: ContextAwsLambdaCaller,
  ): Promise<{ rider: SvcTrophySeaturtle }> =>
    askLambdaEndpoint<{ uuid: string }, { rider: SvcTrophySeaturtle }>(
      { which: { service: 'svc-trophy', function: 'getRider' }, event },
      context,
    ),
  getSponsor: (
    event: { uuid: string },
    context: ContextAwsLambdaCaller,
  ): Promise<{ sponsor: SvcTrophySponsor }> =>
    askLambdaEndpoint<{ uuid: string }, { sponsor: SvcTrophySponsor }>(
      { which: { service: 'svc-trophy', function: 'getSponsor' }, event },
      context,
    ),
  getTrophy: (
    event: { uuid: string },
    context: ContextAwsLambdaCaller,
  ): Promise<{ trophy: SvcTrophySurfTrophy }> =>
    askLambdaEndpoint<{ uuid: string }, { trophy: SvcTrophySurfTrophy }>(
      { which: { service: 'svc-trophy', function: 'getTrophy' }, event },
      context,
    ),
};
"
