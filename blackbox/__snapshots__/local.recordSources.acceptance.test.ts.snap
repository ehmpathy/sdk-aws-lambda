  "level": "warn",
  "message": "lambda.event.refused",
  "metadata": {
    "class": "ConstraintError",
    "consequence": "the whole batch is answered as a success, so sqs deletes every message in it, good ones included; this line is the only trace. serve sqs with genLambdaEndpoint.forSqs to acknowledge a refused message alone",
    "errorMessage": "✋ ConstraintError: validation failed: Records.1.body.orderId: Invalid input: expected string, received undefined",
    "idLast": null,
    "ids": [
