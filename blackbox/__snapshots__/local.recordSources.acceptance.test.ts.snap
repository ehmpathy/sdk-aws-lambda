      "<uuid>",
    ],
    "idsCount": 2,
    "issues": [
      {
        "code": "invalid_type",
        "message": "Invalid input: expected string, received undefined",
        "path": "Records.1.body.orderId",
      },
    ],
    "issuesCount": 1,
    "source": "sqs",
  },
  "timestamp": "<timestamp>",
  "trail": {
    "exid": "exid:<uuid>",
    "stack": [],
  },
}
`;

